# ================================================================
# SUPABASE CONFIGURATION (Public Client)
# ================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Server-side Admin (Chỉ dùng server-side, không prefix NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ================================================================
# AI CLOUD / MULTI-PROVIDER CONFIGURATION (Server-side Only)
# ================================================================
# Chọn provider: 'gemini' | 'openrouter' | 'custom'
AI_PROVIDER=gemini

# Cấu hình Google Gemini Cloud:
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEYS=your_gemini_api_key_here

# Cấu hình OpenRouter (Tùy chọn):
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
